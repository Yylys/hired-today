<view class="boxs">
  <view class="box" wx:for="{{list}}">
    <!-- 头像 -->
    <view style="width: 650rpx;margin:20rpx auto 0; display: flex; align-items: center; justify-content: space-between;">
      <view style="display: flex; align-items: center; flex: 1;">
        <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx;">
          <image style="width: 100%; height: 100%;  border-radius: 50%;" src="{{imgurl + item.user.avatar}}" mode="aspectFill" />
        </view>
        <view>
          <view class="tit text_ellipsis" style="font-size:28rpx;font-weight: 700; width: 480rpx;">{{item.collectionName}}</view>
          <view class="nam" style="color: #524B6B;font-size:24rpx">{{item.user.nickName}}</view>
        </view>
      </view>
      <button open-type="share" data-id="{{item.id}}" data-title="{{item.collectionName}}" style="width: 60rpx;height: 60rpx;padding: 0;margin:0; background-color: #FFF;box-shadow: 0 1px 5px 0 rgba(0, 0, 0, 0.1) ;border-radius: 20rpx;">
        <image style="width: 60rpx;height: 60rpx;position: absolute; top: 0; left:0rpx; " src="/static/imgs/detail/zf.jpg" mode="aspectFill" />
      </button>
    </view>
    <!-- 线条 -->
    <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 24rpx 0 0;"></view>
    <view class="card" bind:tap="goinfo" data-path="/pages/collList/collList" data-sid="{{item.id}}">
      <view class="top">
        <view style="display: flex;">
          <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx; border-radius: 20rpx;">
            <image style="width: 84rpx; height: 84rpx;  border-radius: 20rpx;" src="{{item.job.enterprise ? imgurl + item.job.enterprise.avatar : imgurl + item.job.headhunterResultDTO.avatar}}" mode="aspectFill" />
          </view>
          <view>
            <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{item.job.jobName}}</view>
            <view style="font-weight: 400;font-size:24rpx">{{item.job.address}}</view>
          </view>
        </view>
      </view>
      <view class="cens">
        <view class="list">
          <view wx:for="{{item.job.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
      </view>
      <!-- 线条 -->
      <view class="btm">
        <view class="left">
          <view style="font-size:24rpx ;color:#808289 ;margin: 16rpx 0;">Containing {{item.collectionCount}} job positions</view>
        </view>
        <view class="right" style="margin-bottom: 10rpx;">
          <span style="font-size:36rpx;color:#2623d1;font-weight:600">$10K-$15k</span>
          <span style="font-size:24rpx;color: #808289;font-weight:400">/Month</span>
        </view>
      </view>
    </view>
  </view>
</view>