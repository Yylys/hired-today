@charset "UTF-8";

.t-button--primary.t-button--disabled {
    background-color: var(--themeColor) !important;
    opacity: .6 !important;
}

.tapstate_mark {
    position: relative;
    box-sizing: border-box;
}

.tapstate_mark::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    opacity: 0.1;
    background: #000;
    border-radius: inherit;
}