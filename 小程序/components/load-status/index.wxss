.load_status_c {
    text-align: center;
    width: 100%;
}

.loading {
    padding: 20rpx 0;
}

.no_more {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20rpx 0 28rpx;
}

.no_more .text {
    padding: 0 20rpx;
    color: #969799;
    font-size: 28rpx;
}

.no_more .line {
    width: 80rpx;
    height: 2rpx;
    background-color: #aeb0b1;
}

.no_more .left {
    background: linear-gradient(to right, #f5f5f5 0%, #aeb0b1 100%);
}

.no_more .right {
    background: linear-gradient(to left, #f5f5f5 0%, #aeb0b1 100%);
}

.empty_img {
    margin-top: 100rpx;
    width: 480rpx;
}

.des {
    padding-top: 6rpx;
    padding-bottom: 20rpx;
    font-size: 28rpx;
    color: #969799;
}