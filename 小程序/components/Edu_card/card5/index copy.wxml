<!--components/card/index.wxml-->

<view style="padding-bottom: 100rpx; margin:0 20rpx;">
  <van-swipe-cell right-width="{{100}}" wx:for="{{10}}" data-index="{{index}}" bind:open="openbox" bind:close="closebox" >
    <van-cell-group>
      <view class="box">
        <view class="card" bind:tap="goinfo" >
          <view class="top">
            <view style="display: flex;">
              <image style="width: 84rpx; height: 84rpx; margin-right: 16rpx;" src="/static/imgs/avator.jpg" mode="aspectFill" />
              <view>
                <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">UI/UX Designer</view>
                <view style="font-weight: 400;font-size:24rpx">Google inc.California, USA</view>
              </view>
            </view>
            <view style="height: 40rpx;padding: 10rpx 16rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 24rpx; ">Headhunter</view>
          </view>
          <view class="cens">
            <view class="list">
              <view wx:for="{{3}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">Undergraduate</view>
            </view>

          </view>
          <!-- 线条 -->
          <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
          <view class="btm">
            <view class="left">
              <view class="avatar-stack">
                <image class="avatar" src="https://i.postimg.cc/mgsKJGLw/susu1.jpg"></image>
                <image class="avatar" src="https://i.postimg.cc/mgsKJGLw/susu1.jpg"></image>
                <image class="avatar" src="https://i.postimg.cc/mgsKJGLw/susu1.jpg"></image>
                <image class="avatar" src="https://i.postimg.cc/mgsKJGLw/susu1.jpg"></image>
                <image class="avatar" src="https://i.postimg.cc/mgsKJGLw/susu1.jpg"></image>
              </view>
              <view style="font-size:24rpx ;color:#808289 ;margin: 16rpx 0;">122Applicants</view>
            </view>
            <view class="right" style="margin-bottom: 10rpx;">
              <span style="font-size:36rpx;color:#2623d1;font-weight:600">$10K-$15k</span>
              <span style="font-size:24rpx;color: #808289;font-weight:400">/Month</span>
            </view>
          </view>
        </view>
      </view>
    </van-cell-group>
    <view slot="right" class="van-swipe-cell__right">删除</view>
  </van-swipe-cell>
</view>