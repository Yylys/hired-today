.s_paging {
    width: 100%;
}

.load_status_c {
    text-align: center;
    width: 100%;
}

.loadingDefault,
.emptyDefault {
    display: none;
}

.loadingDefault {
    padding: 20rpx 0;
}

.loadingSlot:empty+.loadingDefault,
.emptySlot:empty+.emptyDefault {
    display: block;
}

.emptyDefault .empty_img {
    margin-top: 100rpx;
    width: 500rpx;
    height: 500rpx;
}

.emptyDefault .des {
    padding-bottom: 20rpx;
    font-size: 28rpx;
    color: #969799;
}

.no_more {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20rpx 0 28rpx;
}

.no_more .text {
    padding: 0 20rpx;
    color: #969799;
    font-size: 28rpx;
}

.no_more .line {
    width: 80rpx;
    height: 2rpx;
    background-color: #aeb0b1;
}

.no_more .left {
    background: linear-gradient(to right, #f5f5f5 0%, #aeb0b1 100%);
}

.no_more .right {
    background: linear-gradient(to left, #f5f5f5 0%, #aeb0b1 100%);
}



.skeleton {
  /* padding: 16px; */
}

.skeleton-item {
  width: 90vw;
  margin: 0 auto;
  height: 300rpx;
  margin-bottom: 10rpx;
  background-color: #e0e0e0; /* 骨架屏颜色 */
  border-radius: 20rpx;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    background-color: #e0e0e0;
  }
  50% {
    background-color: #f0f0f0;
  }
  100% {
    background-color: #e0e0e0;
  }
}


.skeleton-card {
  width: 90vw;
  margin: 0 auto;
  background: #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.skeleton-image {
  width: 100%;
  height: 120rpx;
  background: linear-gradient(90deg, #e0e0e0 25%, #f0f0f0 50%, #e0e0e0 75%);
  border-radius: 8rpx;
  animation: loading 1.5s infinite;
}

.skeleton-title {
  margin: 12rpx 0;
  height: 20rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  width: 80%;
  animation: loading 1.5s infinite;
}

.skeleton-price {
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  width: 60%;
  animation: loading 1.5s infinite;
}

@keyframes loading {
  0% {
    background-position: -150%;
  }
  100% {
    background-position: 150%;
  }
}