<view style="background-color: #fff; min-height: 80vh; padding-bottom: 200rpx;">
  <view class="weui-cell__bd">
    <view class="title">Choose Positions</view>
    <view class='card'>
      <view class="box" wx:for="{{list2}}" bind:tap="toggleSelect" data-item="{{item}}" data-index="{{index}}">
        <view class="cards">
        <view class="top">
          <view style="display: flex; width: 90%;">
            <view style="width: 60rpx; height: 60rpx; margin-right: 16rpx">
              <image style="width: 60rpx; height: 60rpx; border-radius: 20rpx;" src="{{imgurl + item.publish.avatar}}" mode="aspectFill" />
            </view>
            <view>
              <view class="text_ellipsis" style="font-weight: 700;font-size:24rpx;margin-bottom:5rpx ; width: 70%;">{{item.jobName}}</view>
              <view style="font-weight: 400;font-size:20rpx">{{item.address}}</view>
            </view>
          </view>
          <view wx:if="{{item.publishType==1 && item.urgent==1}}" style="height: 30rpx; line-height: 30rpx; padding: 6rpx 10rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 20rpx; ">Headhunter</view>
          <view wx:if="{{(item.publishType==1 && item.urgent==0) || item.urgent==0}}" style="height: 30rpx;line-height: 30rpx; padding: 6rpx 10rpx; background-color:#FFEDED; color: #D12323; border-radius: 8rpx; font-size: 20rpx; ">Urgent</view>
        </view>
        <view class="cens">
          <view class="list">
            <view wx:for="{{item.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 20rpx;margin-right: 10rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
          </view>
          <view wx:if="{{item.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
            <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
            <span style="color:#2623D1;font-size:23rpx">￥{{item.recruiterPrice}}</span>
          </view>
        </view>
        <!-- 线条 -->
        <view style="width: 90%;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
        <view class="btm">
          <view class="left">
            <view class="avatar-stack" wx:if="{{item.userList.length>0}}">
              <image wx:for="{{item.userList}}" class="avatar" src="{{imgurl + item.avatar}}"></image>
            </view>
            <view style="font-size:20rpx ;color:#808289 ;margin: 10rpx 0;">{{item.cnt || 0}} Applicants</view>
          </view>
          <view class="right" style="margin-bottom: 10rpx;">
            <span style="font-size:30rpx;color:#2623d1;font-weight:600">￥{{item.minSalary/1000}}K-￥{{item.maxSalary/1000}}K</span>
            <span style="font-size:20rpx;color: #808289;font-weight:400">/Month</span>
          </view>
        </view>
      </view>
      </view>
      <van-button bind:tap="goinfo" data-path="/pages/joblist/joblist" custom-class="btns" custom-style="border-color: #fff;" icon="add-o" plain color="#FF9228" block>Choose Positions</van-button>
    </view>
  </view>

  <!-- <view class="weui-cell__bd" style="position: relative;">
    <view class="title">Job Collection Classification</view>
    <input disabled bind:tap="showjob" class="weui-input" style="background-color: #F4F5F8;" name="degree" value="{{jobname}}" type="text" placeholder="Please Choose" bindblur="onPhoneInput" />
    <van-icon style="width: 40rpx; height: 40rpx; position:absolute; bottom: 30rpx; right: 30rpx;" name="arrow-down" />
  </view> -->

  <view class="weui-cell__bd">
    <view class="title">Poster Title</view>
    <textarea adjust-position="{{true}}" value="{{lists.collectionName}}" class="weui-inputs"  name="need" type="text" placeholder="Give Your Open Positions an Attractive Title" bindinput="handleInput" data-title="lists.collectionName"></textarea>
  </view>

  <view class="weui-cell__bd">
    <view class="titles">1、Creating a job collection can generate a recruitment poster, which can be shared anywhere to increase exposure.</view>
    <view class="titles">2、A job collection can include multiple similar or different types of positions</view>
  </view>

  <view  style="position:fixed; bottom: 0; height: 150rpx; width: 100%; background: #FFFFFF;">
    <view style="width: 90%; margin:30rpx auto;">
      <button open-type="getUserInfo" bindgetuserinfo="getUserInfo" style="background-color: #2623D1; color: #ffffff;" block>CREATE</button>
    </view>
    <!-- <button class="custom-button" open-type="getUserInfo" bindgetuserinfo="getUserInfo" style="color:#2623D1;border:1px solid #2623D1;" plain>Save poster</button> -->
  </view>
</view>
<van-popup show="{{ showjob }}" bind:close="onClose" position="bottom">
  <van-picker confirm-button-text="confirm" cancel-button-text="cancel" columns="{{ columns5 }}" value-key="memberName" default-index="{{ item.sid }}" bind:cancel="onClose" bind:confirm="onConfirm5" show-toolbar title="" />
</van-popup>

<share-box wx:if="{{isCanDraw}}" info="{{fxlist}}" isCanDraw="{{isCanDraw}}" bind:initData="createShareImage" bind:close="handleClose" />