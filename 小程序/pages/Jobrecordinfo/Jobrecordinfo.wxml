<!--components/card/index.wxml-->
<view style="padding-bottom: 100rpx;">
  <view class="box">
    <view class="card" bind:tap="goinfo" data-path="/pages/cardinfo/cardinfo" data-sid="{{info.sid}}">
      <view class="top">
        <view style="display: flex;">
          <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
            <image style="width: 84rpx; height: 84rpx; border-radius: 20rpx;" src="{{imgurl + info.publish.avatar}}" mode="aspectFill" />
          </view>
          <view>
            <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{info.jobName}}</view>
            <view style="font-weight: 400;font-size:24rpx">{{info.address}}</view>
          </view>
        </view>
        <view wx:if="{{info.feedbackType==0}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1C54EE; background-color: #EAEEFF; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">No Feedback</view>
        <view wx:if="{{info.feedbackType==2}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FF9228; background-color: #FFF6ED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Inviting</view>
        <view wx:if="{{info.feedbackType==1}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #FFEDED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Candidate Unfit</view>
        <view wx:if="{{info.feedbackType==7}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #FFEDED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Candidate Unfit</view>
        <view wx:if="{{info.feedbackType==4}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Pending Interview</view>
        <view wx:if="{{info.feedbackType==3}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Passed</view>
        <view wx:if="{{info.feedbackType==5}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Passed</view>
        <view wx:if="{{info.feedbackType==6}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Interview Invitation Failed</view>
        <view wx:if="{{info.feedbackType==8}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FF9228; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Inviting</view>
      </view>
      <view class="cens">
        <view class="list">
          <view wx:for="{{info.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
        <view wx:if="{{info.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
          <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
          <span style="color:#2623D1;font-size:28rpx">￥{{info.recruiterPrice}}</span>
        </view>
      </view>
      <!-- 线条 -->
      <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
      <view class="btm">
        <view class="title">Feedback</view>
        <view class="nth">{{info.feedbackContent || 'None'}}</view>
      </view>
    </view>
  </view>
  <view class="box">
    <view class="card" bind:tap="goinfo" data-path="{{userKey=='candidate' ? '' : '/pages/TalentDetails/TalentDetails'}}" data-sid="{{info.userInfo.sid}}" data-type="{{info.feedbackType==0 || info.feedbackType==8 ? 1 : null}}">
      <view class="top">
        <view style="display: flex; width: 100%;">
          <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
            <image style="width: 84rpx; height: 84rpx;border-radius: 50%;" src="{{imgurl+ info.userInfo.avatar}}" mode="aspectFill" />
          </view>
          <view style="flex:1">
            <view style="display: flex; justify-content: space-between; width: 100%;">
              <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{info.userInfo.fullName}} <span class="tt">
                  <image wx:if="{{info.userInfo.sex==0}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                  <image wx:if="{{info.userInfo.sex==1}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                </span>
              </view>
              <span style="font-size:36rpx;color:#2623d1;font-weight:600">￥{{info.userInfo.minSalary/1000}}K-￥{{info.userInfo.maxSalary/1000}}K</span>
            </view>
            <view style="font-size:24rpx;color:#524B6B">{{info.userInfo.age}} years old | <span style="font-weight:900;">{{info.userInfo.desiredIndustry}}</span>
            </view>
          </view>
        </view>
      </view>
      <view style="display: flex; flex-direction:column;align-items:flex-end;">
        <view wx:if="{{info.userInfo.isHeadhunting==0}}" style="height: 50rpx;line-height: 50rpx; background-color:#E3E3FF; width: 150rpx; color: #2623D1; border-radius: 8rpx; font-size: 24rpx;  text-align: center;">Headhunter</view>
      </view>
      <view class="cens">
        <view class="list" style=" white-space: pre-wrap;">
          <view style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{info.userInfo.countries.countriesName}}</view>
          <view wx:for="{{info.userInfo.tag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
        <view wx:if="{{info.userInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
          <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
          <span style="color:#2623D1;font-size:28rpx">￥{{info.userInfo.recruiterPrice}}</span>
        </view>
      </view>
      <!-- 线条 -->
      <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
      <view class="btm line_ellipsis" style="margin:20rpx;">
        {{info.userInfo.content}}
      </view>
      <view wx:if="{{actives==1}}" style="display: flex; align-items: center; justify-content: space-between;">
        <view style="color: #AAA6B9; font-size: 24rpx; margin: 10rpx 20rpx 20rpx;">{{info.created}}</view>
        <view style="padding: 20rpx;">
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==0}}">No Feedback</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==1 || info.state	==7}}">Candidate Unfit</view>
          <view style="font-size: 24rpx; color:#FF9228" wx:if="{{info.state==2}}">Inviting</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state==3}}">Passed</view>
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==4}}">Pending Interview</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state	==5}}">Passed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==6}}">Interview Invitation Failed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==8}}">Inviting</view>
        </view>
      </view>
      <view class="btm">
        <!-- <view class="title">Submit</view> -->
        <view class="nth">{{info.submitContent || 'None'}}</view>
      </view>
    </view>
  </view>
</view>