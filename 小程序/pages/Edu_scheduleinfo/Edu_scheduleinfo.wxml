<!--components/card/index.wxml-->
<view style="display: flex; flex-direction: column;">
<view class="box" style="width: 90%; margin-left:5%">
  <view class="card" bind:tap="goinfo" data-path="/pages/TalentDetails/TalentDetails" data-sid="{{info.userInfo.sid}}">
    <view class="tops">
        <view style="display: flex; width: 100%;">
          <view style="width: 74rpx; height: 74rpx; margin-right: 16rpx">
            <image style="width: 74rpx; height: 74rpx;border-radius: 50%;" src="{{imgurl+ info.userInfo.avatar}}" mode="aspectFill" />
          </view>
          <view style="flex:1">
            <view style="display: flex; justify-content: space-between; width: 100%;">
              <view style="font-weight: 700;font-size:25rpx;margin-bottom:12rpx ;">{{info.userInfo.fullName}} <span class="tt">
                  <image wx:if="{{info.userInfo.sex==0}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                  <image wx:if="{{info.userInfo.sex==1}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                </span>
              </view>
              <span style="font-size:32rpx;color:#2623d1;font-weight:600;white-space: nowrap;">￥{{info.userInfo.minSalary/1000}}K-￥{{info.userInfo.maxSalary/1000}}K</span>
            </view>
            <view style="font-size:24rpx;color:#524B6B">{{info.userInfo.age}} years old | <span style="font-weight:900;">{{info.userInfo.desiredIndustry}}</span>
            </view>
          </view>
        </view>
      </view>
      <view style="display: flex; flex-direction:column;align-items:flex-end;">
        <view wx:if="{{info.userInfo.isHeadhunting==0}}" style="height: 50rpx;line-height: 50rpx; background-color:#E3E3FF; width: 150rpx; color: #2623D1; border-radius: 8rpx; font-size: 24rpx;  text-align: center;">Headhunter</view>
      </view>
      <view class="cen">
        <view class="list" style=" white-space: pre-wrap;">
          <view  style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{info.userInfo.countries.countriesName}}</view>
          <view wx:for="{{info.userInfo.tag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
        <view wx:if="{{info.userInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
          <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
          <span style="color:#2623D1;font-size:28rpx">￥{{info.userInfo.recruiterPrice}}</span>
        </view>
      </view>
      <!-- 线条 -->
      <view style="width: 90%;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
      <view class="btms line_ellipsis" style="margin:20rpx;">
        {{info.userInfo.content}}
      </view>
  </view>
</view>

<view class="boxs" style="margin-bottom: 30rpx; padding-bottom: 30rpx;">
  <view class="box">
    <view>
      <view class="card" style="width:660rpx" bind:tap="goinfo" data-path="/pages/cardinfo/cardinfo" data-sid="{{info.jobInfo.sid}}">
        <view class="top">
          <view style="display: flex;width: 60%;">
            <view style="width: 74rpx; height: 74rpx; margin-right: 16rpx">
              <image style="width: 74rpx; height: 74rpx; border-radius: 20rpx;" src="{{imgurl + info.jobInfo.publish.avatar}}" mode="aspectFill" />
            </view>
            <view>
              <view  style="font-weight: 700;font-size:25rpx;margin-bottom:10rpx ; width: 400rpx;">{{info.jobInfo.jobName}}</view>
              <view style="font-weight: 400;font-size:22rpx">{{info.jobInfo.address}}</view>
            </view>
          </view>
          <view wx:if="{{info.jobInfo.publishType==1 && info.jobInfo.urgent==1}}" style="height: 36rpx; line-height: 36rpx; padding: 10rpx 16rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 22rpx; ">Headhunter</view>
          <view wx:if="{{(info.jobInfo.publishType==1 && info.jobInfo.urgent==0) || info.jobInfo.urgent==0}}" style="height: 36rpx;line-height: 36rpx; padding: 10rpx 16rpx; background-color:#FFEDED; color: #D12323; border-radius: 8rpx; font-size: 22rpx; ">Urgent</view>
        </view>
        <view class="cens">
          <view class="list">
            <view wx:for="{{info.jobInfo.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 22rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
          </view>
          <view wx:if="{{info.jobInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
            <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
            <span style="color:#2623D1;font-size:25rpx">￥{{info.jobInfo.recruiterPrice}}</span>
          </view>
        </view>
        <!-- 线条 -->
        <view style="width:90%;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
        <view class="btm">
          <view class="left">
            <view class="avatar-stack" wx:if="{{info.jobInfo.userList.length>0}}">
              <image wx:for="{{info.jobInfo.userList}}" class="avatar" src="{{imgurl + item.avatar}}"></image>
            </view>
            <view style="font-size:22rpx ;color:#808289 ;margin: 16rpx 0;">{{info.jobInfo.cnt || 0}} Applicants</view>
          </view>
          <view class="right" style="margin-bottom: 10rpx;">
            <span style="font-size:32rpx;color:#2623d1;font-weight:600">￥{{info.jobInfo.minSalary/1000}}K-￥{{info.jobInfo.maxSalary/1000}}K</span>
            <span style="font-size:22rpx;color: #808289;font-weight:400">/Month</span>
          </view>
        </view>
      </view>
    </view>
  </view>
  <!-- 线条 -->
  <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
  <view style="width: 622rpx; margin:0 auto;">
    <view style="display: flex;">
      <view class="lists">
        <view class="title">Interviewer</view>
        <view class="nth">{{info.interviewer}}</view>
      </view>
      <view class="lists">
        <view class="title">Interview platform</view>
        <view class="nth">{{info.platform}}</view>
      </view>
    </view>
    <view class="lists" style="width: 100%;">
      <view class="title">Interview number</view>
      <view class="nth">{{info.numberOfInterviews}}</view>
    </view>
    <view class="lists" style="width: 100%;">
      <view class="title">{{info.title}}</view>
      <view class="nth">{{info.detail }}</view>
    </view>
    <view class="lists" style="width: 100%;">
      <view class="title">Please select your interview time</view>
      <view class="nth">Please note, this is Beijing Time</view>
    </view>
    <view class="lists" style="width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between;">
      <view bind:tap="settime" class="bac1">{{info.time}}</view>
    </view>
  </view>
</view>
</view>


<view class="tab" wx:if="{{info.state==4}}">
  <button class="btn" data-sid="{{info.sid}}" data-path="/pages/Interview_Feedback/Interview_Feedback" bind:tap="goyq">INTERVIEW FEEDBACK</button>
</view>