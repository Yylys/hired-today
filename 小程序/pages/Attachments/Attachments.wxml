<!--pages/advantage/advantage.wxml-->
<view style="width: 670rpx; margin:0 auto;">
  <view class="title">Attachments</view>
  <view style="background-color: #fff; border-radius: 36rpx; padding: 20rpx 20rpx;">
    <van-uploader  image-fit="aspectFill" bind:delete="delimg"  file-list="{{ fileList }}" bind:after-read="afterRead" max-count="5">
      <view style="display: flex; align-items: center; justify-content: center; border: 1rpx dashed #9D97B5; border-radius: 36rpx; width: 620rpx; padding: 60rpx 0; margin-bottom: 20rpx;">
        <van-icon size="40rpx" name="photo-o" />
        <span style="color: #150A33; font-size: 24rpx; margin-left: 10rpx;">Upload Image</span>
      </view>
    </van-uploader>
  </view>
  <view style="margin: 78rpx auto; width: 60%; padding-bottom: 100rpx;">
    <van-button bind:tap="setdatas" type="primary" color="#2623D1" block>Submit</van-button>
  </view>
</view>