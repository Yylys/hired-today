<!--components/card/index.wxml-->
<view style="padding-bottom: 100rpx;">
  <view class="box">
    <view class="card" bind:tap="goinfo" data-path="/pages/TalentDetails/TalentDetails" data-sid="{{info.userInfo.sid}}">
      <view class="top">
        <view style="display: flex; width: 100%;">
          <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
            <image style="width: 84rpx; height: 84rpx;border-radius: 50%;" src="{{imgurl+ info.userInfo.avatar}}" mode="aspectFill" />
          </view>
          <view style="flex:1">
            <view style="display: flex; justify-content: space-between; width: 100%;">
              <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{info.userInfo.fullName}} <span class="tt">
                  <image wx:if="{{info.userInfo.sex==0}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                  <image wx:if="{{info.userInfo.sex==1}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                </span>
              </view>
              <span style="font-size:36rpx;color:#2623d1;font-weight:600;white-space: nowrap;">￥{{info.userInfo.minSalary/1000}}K-￥{{info.userInfo.maxSalary/1000}}K</span>
            </view>
            <view style="font-size:24rpx;color:#524B6B">{{info.userInfo.age}} years old | <span style="font-weight:900;">{{info.userInfo.desiredIndustry}}</span>
            </view>
          </view>
        </view>
      </view>
      <view style="display: flex; flex-direction:column;align-items:flex-end;">
        <view wx:if="{{info.userInfo.isHeadhunting==0}}" style="height: 50rpx;line-height: 50rpx; background-color:#E3E3FF; width: 150rpx; color: #2623D1; border-radius: 8rpx; font-size: 24rpx;  text-align: center;">Headhunter</view>
      </view>
      <view class="cens">
        <view class="list" style=" white-space: pre-wrap;">
          <view style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{info.userInfo.countries.countriesName}}</view>
          <view wx:for="{{info.userInfo.tag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
        <view wx:if="{{info.userInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
          <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
          <span style="color:#2623D1;font-size:28rpx">￥{{info.userInfo.recruiterPrice}}</span>
        </view>
      </view>
      <!-- 线条 -->
      <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
      <view class="btm line_ellipsis" style="margin:20rpx;">
        {{info.userInfo.content}}
      </view>
      <view wx:if="{{actives==1}}" style="display: flex; align-items: center; justify-content: space-between;">
        <view style="color: #AAA6B9; font-size: 24rpx; margin: 10rpx 20rpx 20rpx;">{{info.created}}</view>
        <view style="padding: 20rpx;">
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==0}}">No Feedback</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==1 || info.state	==7}}">Candidate Unfit</view>
          <view style="font-size: 24rpx; color:#FF9228" wx:if="{{info.state==2}}">Inviting</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state==3}}">Passed</view>
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==4}}">Pending Interview</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state	==5}}">Passed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==6}}">Interview Invitation Failed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==8}}">Pending Confirmation</view>
        </view>
      </view>
    </view>
  </view>
  <view class="box">
    <view class="card" bind:tap="goinfo" data-path="/pages/cardinfo/cardinfo" data-sid="{{info.jobInfo.sid}}">
      <view class="top">
        <view style="display: flex;">
          <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
            <image style="width: 84rpx; height: 84rpx; border-radius: 20rpx;" src="{{imgurl + info.jobInfo.publish.avatar}}" mode="aspectFill" />
          </view>
          <view>
            <view class="text_ellipsis" style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ; width: 400rpx;">{{info.jobInfo.jobName}}</view>
            <view style="font-weight: 400;font-size:24rpx">{{info.jobInfo.address}}</view>
          </view>
        </view>
        <view wx:if="{{info.jobInfo.publishType==1 && info.jobInfo.urgent==1}}" style="height: 40rpx; line-height: 40rpx; padding: 10rpx 16rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 24rpx; ">Headhunter</view>
        <view wx:if="{{(info.jobInfo.publishType==1 && info.jobInfo.urgent==0) || info.jobInfo.urgent==0}}" style="height: 40rpx;line-height: 40rpx; padding: 10rpx 16rpx; background-color:#FFEDED; color: #D12323; border-radius: 8rpx; font-size: 24rpx; ">Urgent</view>
      </view>
      <view class="cens">
        <view class="list">
          <view wx:for="{{info.jobInfo.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
        </view>
        <view wx:if="{{info.jobInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
          <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
          <span style="color:#2623D1;font-size:28rpx">￥{{info.jobInfo.recruiterPrice}}</span>
        </view>
      </view>
      <!-- 线条 -->
      <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
      <view class="btm">
        <view class="title">Feedback</view>
        <view class="nth">{{info.reason || 'none'}}</view>
      </view>
    </view>
  </view>
</view>