<view style="background-color: #fff; min-height: 80vh; padding-bottom: 200rpx;">
  <view class="weui-cell__bd">
    <view class="title">Choose Talents</view>
    <view class='card'>
      <view class="box" wx:for="{{list2}}" bind:tap="toggleSelect" data-item="{{item}}" data-index="{{index}}">
        <view style="padding: 20rpx 30rpx;">
          <view class="top">
            <view style="display: flex;">
              <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx;">
                <image style="width: 84rpx; height: 84rpx; border-radius: 50%;" src="{{imgurl + item.avatar}}" mode="aspectFill" />
              </view>
              <view>
                <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ; display: flex; align-items: center;">{{item.fullName}}
                  <image wx:if="{{item.sex==0}}" style="width: 24rpx;height: 24rpx; margin-left: 10rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                  <image wx:if="{{item.sex==1}}" style="width: 24rpx;height: 24rpx; margin-left: 10rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                </view>
                <view style="font-weight: 400;font-size:24rpx">{{item.age}} years old · {{item.countriesName}}</view>
              </view>
            </view>
            <!-- <view wx:if="{{item.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
              <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
              <span style="color:#2623D1;font-size:28rpx">￥{{item.recruiterPrice}}</span>
            </view> -->
          </view>
        </view>
      </view>
      <van-button bind:tap="goinfo" data-path="/pages/talentlist/talentlist" custom-class="btns" custom-style="border-color: #fff;" icon="add-o" plain color="#FF9228" block>Choose Talents</van-button>
    </view>
  </view>

  <!-- <view class="weui-cell__bd" style="position: relative;">
    <view class="title">TalClassificationent Collection </view>
    <input disabled bind:tap="showjob" class="weui-input" style="background-color: #F4F5F8;" name="degree" value="{{jobname}}" type="text" placeholder="Please Choose" />
    <van-icon style="width: 40rpx; height: 40rpx; position:absolute; bottom: 30rpx; right: 30rpx;" name="arrow-down" />
  </view> -->

  <view class="weui-cell__bd">
    <view class="title">Poster Title</view>
    <textarea adjust-position="{{true}}" bindinput="handleInput" value="{{lists.collectionName}}" class="weui-inputs" name="collectionName" type="text" placeholder="Please Enter a Title for Your Talent Promotion Collection"></textarea>
  </view>

  <view class="weui-cell__bd">
    <view class="titles">Create a collection of your talent and expose them to hiring companies in bulk! This allows you to recommend your candidates more quickly!</view>
  </view>

  <view style="position:fixed; bottom: 0; height: 150rpx; width: 100%; background: #FFFFFF;">
    <view style="width: 90%; margin:30rpx auto;">
      <button open-type="getUserInfo" bindgetuserinfo="getUserInfo" style="background-color: #2623D1; color: #ffffff;" block>CREATE</button>
    </view>
    <!-- <button class="custom-button" open-type="getUserInfo" bindgetuserinfo="getUserInfo" style="color:#2623D1;border:1px solid #2623D1;" plain>Save poster</button> -->
  </view>
</view>
<van-popup show="{{ showjob }}" bind:close="onClose" position="bottom">
  <van-picker confirm-button-text="confirm" cancel-button-text="cancel" columns="{{ columns5 }}" value-key="memberName" default-index="{{ item.sid }}" bind:cancel="onClose" bind:confirm="onConfirm5" show-toolbar title="" />
</van-popup>

<share-box wx:if="{{isCanDraw}}" wx:if="{{isCanDraw}}" info="{{fxlist}}" isCanDraw="{{isCanDraw}}" bind:initData="createShareImage" bind:close="handleClose" />