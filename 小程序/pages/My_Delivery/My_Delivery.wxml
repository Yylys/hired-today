<view>
  <view>
    <van-tabs animated sticky color='#2623D1' title-active-color='#2623D1' title-inactive-color='#150B3D' active="{{ active }}" bind:change="onChange">
      <van-tab title="My Talent">
        <view class="cate_warp">
          <scroll-view scroll-x="true" class="scroll-views" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="true">
            <view class="menu-item" wx:for="{{CateList1}}" wx:key="index" id="item-{{index}}" data-index="{{item.id}}" data-acid="{{item.id}}" bindtap="onCateItem1">
              <view class="item11">
                <view class="{{actives1==item.id?'cate_name_active':'cate_name'}}">{{item.name}}</view>
              </view>
            </view>
          </scroll-view>
          <scroll-view class="scroll-view" scroll-y="true">
            <paging reqUrl="/v1/resume/my-delivery-job" params='{{params2}}' immediatecheck="{{false}}" pagingRefField="post" filed="list3">
              <!--components/card/index.wxml-->
              <view>
                <view class="box" style="width: 95%; margin:20rpx auto;" wx:for="{{list3}}">
                  <view style="padding-top: 20rpx; margin: 0 auto; width: 650rpx; color:#808289; font-size: 28rpx;">{{item.updated}}</view>
                  <view style="width: 650rpx;height: 2rpx; background-color: #E4E7ED; margin: 10rpx auto 0;"></view>
                  <view class="card" bind:tap="goinfo" data-path="/pages/Jobrecordinfo/Jobrecordinfo" data-sid="{{item.sid}}" data-id="{{item.userInfo.sid}}">
                    <view class="top">
                      <view style="display: flex; width: 60%;">
                        <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
                          <image style="width: 84rpx; height: 84rpx;  border-radius: 20rpx;" src="{{imgurl + item.publish.avatar}}" mode="aspectFill" />
                        </view>
                        <view>
                          <view class="text_ellipsis" style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ; width: 400rpx;">{{item.jobName}}</view>
                          <view style="font-weight: 400;font-size:24rpx">{{item.address}}</view>
                        </view>
                      </view>
                      <!-- <view wx:if="{{item.publishType==1 && item.urgent==1}}" style="height: 40rpx; line-height: 40rpx; padding: 10rpx 16rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 24rpx; ">Headhunter</view>
                      <view wx:if="{{(item.publishType==1 && item.urgent==0) || item.urgent==0}}" style="height: 40rpx;line-height: 40rpx; padding: 10rpx 16rpx; background-color:#FFEDED; color: #D12323; border-radius: 8rpx; font-size: 24rpx; ">Urgent</view> -->
                      <view wx:if="{{info.feedbackType==0}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1C54EE; background-color: #EAEEFF; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">No Feedback</view>
              <view wx:if="{{info.feedbackType==2}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FF9228; background-color: #FFF6ED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Inviting</view>
              <view wx:if="{{info.feedbackType==1}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #FFEDED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Candidate Unfit</view>
              <view wx:if="{{info.feedbackType==7}}" style=" height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #FFEDED; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Candidate Unfit</view>
              <view wx:if="{{info.feedbackType==4}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Pending Interview</view>
              <view wx:if="{{info.feedbackType==3}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Passed</view>
              <view wx:if="{{info.feedbackType==5}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #1EBF77; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Passed</view>
              <view wx:if="{{info.feedbackType==6}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FE4848; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Interview Invitation Failed</view>
              <view wx:if="{{info.feedbackType==8}}" style="height: 40rpx; line-height: 40rpx; font-size: 24rpx;color: #FF9228; background-color: #E7F9F2; padding:12rpx;white-space: nowrap; border-radius: 8rpx;">Pending Confirmation</view>
                    </view>
                    <view class="cens">
                      <view class="list">
                        <view wx:for="{{item.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
                      </view>
                      <view wx:if="{{item.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
                        <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
                        <span style="color:#2623D1;font-size:28rpx">￥{{item.recruiterPrice}}</span>
                      </view>
                    </view>
                    <!-- 线条 -->
                    <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
                    <view class="btm" style="display: flex; justify-content: space-between; align-items: center;">
                      <view class="left">
                        <view class="avatar-stack" wx:if="{{item.userList.length>0}}">
                          <image wx:for="{{item.userList}}" class="avatar" src="{{imgurl + item.avatar}}"></image>
                        </view>
                        <view style="font-size:24rpx ;color:#808289 ;margin: 16rpx 0;">{{item.cnt || 0}} Applicants</view>
                      </view>
                      <view class="right" style="margin-bottom: 10rpx;">
                        <span style="font-size:36rpx;color:#2623d1;font-weight:600;white-space: nowrap;">￥{{item.minSalary/1000}}K-￥{{item.maxSalary/1000}}K</span>
                        <span style="font-size:24rpx;color: #808289;font-weight:400">/Month</span>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </paging>
          </scroll-view>
        </view>
      </van-tab>
      <van-tab title="My Positions">
        <view class="cate_warp">
          <scroll-view scroll-x="true" class="scroll-views" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="true">
            <view class="menu-item" wx:for="{{CateList}}" wx:key="index" id="item-{{index}}" data-index="{{item.id}}" data-acid="{{item.id}}" bindtap="onCateItem">
              <view class="item11">
                <view class="{{actives==item.id?'cate_name_active':'cate_name'}}">{{item.name}}</view>
              </view>
            </view>
          </scroll-view>
          <scroll-view class="scroll-view" scroll-y="true">
            <paging reqUrl="/v1/resume/my-invite" params='{{params1}}' immediatecheck="{{false}}" pagingRefField="delivery" filed="list2">
              <!--components/card/index.wxml-->
              <view style="padding-bottom: 100rpx;">
                <view class="box" style="margin:20rpx" wx:for="{{list2}}">
                  <view class="card" bind:tap="goinfo" data-path="{{actives==1 ? '/pages/Edu_recordinfo/Edu_recordinfo' : '/pages/TalentDetails/TalentDetails'}}" data-sid="{{ actives==1 ? item.sid : item.userInfo.sid}}">
                    <view class="top">
                      <view style="display: flex; width: 100%;">
                        <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
                          <image style="width: 84rpx; height: 84rpx;border-radius: 50%;" src="{{imgurl+ item.userInfo.avatar}}" mode="aspectFill" />
                        </view>
                        <view style="flex:1">
                          <view style="display: flex; justify-content: space-between; width: 100%;">
                            <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{item.userInfo.fullName}} <span class="tt">
                                <image wx:if="{{item.userInfo.sex==0}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                                <image wx:if="{{item.userInfo.sex==1}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                              </span>
                            </view>
                            <span style="font-size:36rpx;color:#2623d1;font-weight:600">￥{{item.userInfo.minSalary/1000}}K-￥{{item.userInfo.maxSalary/1000}}K</span>
                          </view>
                          <view style="font-size:24rpx;color:#524B6B">{{item.userInfo.age}} years old | <span style="font-weight:900;">{{item.userInfo.desiredIndustry}}</span>
                          </view>
                        </view>
                      </view>
                    </view>
                    <view style="display: flex; flex-direction:column;align-items:flex-end;">
                      <view wx:if="{{item.userInfo.isHeadhunting==0}}" style="height: 50rpx;line-height: 50rpx; background-color:#E3E3FF; width: 150rpx; color: #2623D1; border-radius: 8rpx; font-size: 24rpx;  text-align: center;">Headhunter</view>
                    </view>
                    <view class="cens">
                      <view class="list" style=" white-space: pre-wrap;">
                        <view style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.userInfo.countriesName}}</view>
                        <view wx:for="{{item.userInfo.tag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
                      </view>
                      <view wx:if="{{item.userInfo.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
                        <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
                        <span style="color:#2623D1;font-size:28rpx">￥{{item.userInfo.recruiterPrice}}</span>
                      </view>
                    </view>
                    <!-- 线条 -->
                    <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
                    <view class="btm line_ellipsis" style="margin:20rpx;">
                      {{item.userInfo.content}}
                    </view>
                    <view wx:if="{{actives==1}}" style="display: flex; align-items: center; justify-content: space-between;">
                      <view style="color: #AAA6B9; font-size: 24rpx; margin: 10rpx 20rpx 20rpx;">{{item.created}}</view>
                      <view style="padding: 20rpx;">
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==0}}">No Feedback</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==1 || info.state	==7}}">Candidate Unfit</view>
          <view style="font-size: 24rpx; color:#FF9228" wx:if="{{info.state==2}}">Inviting</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state==3}}">Passed</view>
          <view style="font-size: 24rpx; color:#2623D1" wx:if="{{info.state==4}}">Pending Interview</view>
          <view style="font-size: 24rpx; color:#21B60E" wx:if="{{info.state	==5}}">Passed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==6}}">Interview Invitation Failed</view>
          <view style="font-size: 24rpx; color:#FF4B4B" wx:if="{{info.state	==8}}">Pending Confirmation</view>
        </view>
                    </view>

                  </view>
                </view>
              </view>
            </paging>
          </scroll-view>
        </view>
      </van-tab>
    </van-tabs>
  </view>
</view>