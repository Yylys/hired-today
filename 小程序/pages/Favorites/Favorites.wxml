<view>
  <view>
    <van-tabs animated sticky color='#2623D1' title-active-color='#2623D1' title-inactive-color='#150B3D' active="{{ active }}" bind:change="onChange">
      <van-tab title="Talent">
        <view class="cate_warp">
          <scroll-view class="scroll-view" scroll-y="true">
            <paging reqUrl="/v1/resume/my-favorites" immediatecheck="{{false}}" pagingRefField="paging">
              <view style="padding-bottom: 100rpx; margin:0 20rpx;">
                <view wx:for="{{list}}" style="position: relative; margin: 20rpx 0;">
                  <view class="box2">Remove</view>
                  <van-swipe-cell bind:click='dellist' right-width="{{80}}" data-sid="{{item.sid}}">
                    <view class="box">
                      <van-cell-group>
                        <view id="card" class="card" bind:tap="goinfo" data-path="/pages/TalentDetails/TalentDetails" data-sid="{{item.sid}}">
                          <view class="top">
                            <view style="display: flex; width: 100%;">
                              <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx">
                                <image style="width: 84rpx; height: 84rpx;border-radius: 50%;" src="{{imgurl+ item.avatar}}" mode="aspectFill" />
                              </view>
                              <view style="flex:1">
                                <view style="display: flex; justify-content: space-between; width: 100%;">
                                  <view style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;">{{item.fullName}} <span class="tt">
                                      <image wx:if="{{item.sex==0}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/man.jpg" mode="aspectFill" />
                                      <image wx:if="{{item.sex==1}}" style="width: 26rpx;height: 26rpx;" src="/static/imgs/detail/woman.jpg" mode="aspectFill" />
                                    </span>
                                  </view>
                          <span style="font-size:36rpx;color:#2623d1;font-weight:600;white-space: nowrap;">￥{{item.minSalary/1000}}K-￥{{item.maxSalary/1000}}K</span>
                                </view>
                                <view style="font-size:24rpx;color:#524B6B">{{item.age}} years old | <span style="font-weight:900;">{{item.desiredIndustry}}</span>
                                </view>
                              </view>
                            </view>
                          </view>
                          <view style="display: flex; flex-direction:column;align-items:flex-end;">
                            <view wx:if="{{item.isHeadhunting==0}}" style="height: 50rpx;line-height: 50rpx; background-color:#E3E3FF; width: 150rpx; color: #2623D1; border-radius: 8rpx; font-size: 24rpx;  text-align: center;">Headhunter</view>
                          </view>
                          <view class="cens">
                            <view class="list" style=" white-space: pre-wrap;">
                              <view style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.countriesName}}</view>
                              <view wx:for="{{item.tag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
                            </view>
                            <view wx:if="{{item.recruiter==0}}" style="display: flex; align-items: center; margin-right: 0rpx;">
                              <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
                              <span style="color:#2623D1;font-size:28rpx">￥{{item.recruiterPrice}}</span>
                            </view>
                          </view>
                          <!-- 线条 -->
                          <view style="width: 670rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx;"></view>
                          <view class="btms line_ellipsis">
                            {{item.content}}
                          </view>
                        </view>
                      </van-cell-group>
                    </view>
                    <!-- <view slot="right" class="van-swipe-cell__right">删除</view> -->
                  </van-swipe-cell>
                </view>
              </view>
            </paging>
          </scroll-view>
        </view>
      </van-tab>
      <van-tab title="Job">
        <view class="cate_warp">
          <scroll-view class="scroll-view" scroll-y="true">
            <paging reqUrl="/v1/resume/my-job" immediatecheck="{{false}}" pagingRefField="delivery">
              <view style="padding-bottom: 100rpx; ">
                <view wx:for="{{list}}" style="position: relative; margin:20rpx; ">
                  <view class="box2">Remove</view>
                  <van-swipe-cell bind:click='dellists' right-width="{{80}}" data-sid="{{item.sid}}" bind:close="closebox" bind:open="openbox">
                    <view class="box">
                      <van-cell-group>
                        <view class="card" bind:tap="goinfo" data-path="/pages/cardinfo/cardinfo" data-sid="{{item.sid}}">
                          <view class="top">
                            <view style="display: flex; width: 70%;">
                              <view style="width: 84rpx; height: 84rpx; margin-right: 16rpx;">
                                <image style="width: 84rpx; height: 84rpx;  border-radius: 20rpx" src="{{imgurl + item.publish.avatar}}" mode="aspectFill" />
                              </view>
                              <view>
                                <view class="text_ellipsis" style="font-weight: 700;font-size:28rpx;margin-bottom:12rpx ;  width: 70%;">{{item.jobName}}</view>
                                <view style="font-weight: 400;font-size:24rpx">{{item.address}}</view>
                              </view>
                            </view>
                            <view wx:if="{{item.publishType==1 && item.urgent==1}}" style="height: 40rpx;padding: 10rpx 16rpx; line-height: 40rpx; background-color:#E3E3FF; color: #2623D1; border-radius: 8rpx; font-size: 24rpx; ">Headhunter</view>
                            <view wx:if="{{(item.publishType==1 && item.urgent==0) || item.urgent==0}}" style="height: 40rpx; line-height: 40rpx;padding: 10rpx 16rpx; background-color:#FFEDED; color: #D12323; border-radius: 8rpx; font-size: 24rpx; ">Urgent</view>
                          </view>
                          <view class="cens">
                            <view class="list">
                              <view wx:for="{{item.showTag}}" style="background: #F5F4F6;border-radius: 8rpx 8rpx 8rpx 8rpx; padding: 10rpx 12rpx; font-size: 24rpx;margin-right: 30rpx; margin-top: 10rpx ;">{{item.memberName}}</view>
                            </view>
                            <view wx:if="{{item.recruiter==0}}" style="display: flex; align-items: center; margin-right: 20rpx;">
                              <image style="width: 24rpx; height: 24rpx;" src="/static/imgs/money.jpg" mode="aspectFill" />
                              <span style="color:#2623D1;font-size:28rpx">￥{{item.recruiterPrice}}</span>
                            </view>

                          </view>
                          <!-- 线条 -->
                          <view style="width: 580rpx;height: 2rpx; background-color: #E4E7ED; margin: 20rpx auto"></view>
                          <view class="btm">
                            <view class="left">
                              <view class="avatar-stack" wx:if="{{item.userList.length>0}}">
                                <image wx:for="{{item.userList}}" class="avatar" src="{{imgurl + item.avatar}}"></image>
                              </view>
                              <view style="font-size:24rpx ;color:#808289 ;margin: 16rpx 0;">{{item.cnt || 0}} Applicants</view>
                            </view>
                            <view class="right">
                      <span style="font-size:36rpx;color:#2623d1;font-weight:600;white-space: nowrap;">￥{{item.minSalary/1000}}K-￥{{item.maxSalary/1000}}K</span>
                              <span style="font-size:24rpx;color: #808289;font-weight:400">/Month</span>
                            </view>
                          </view>
                        </view>
                      </van-cell-group>
                    </view>
                    <!-- <view slot="right" class="van-swipe-cell__right">删除</view> -->
                  </van-swipe-cell>
                </view>
              </view>
            </paging>
          </scroll-view>
        </view>
      </van-tab>
    </van-tabs>
  </view>
</view>