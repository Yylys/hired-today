.share-wrap {
  width: 100%;
  visibility: hidden;
  position: relative;
}

.share-wrap.active {
  visibility: visible;
}

.share-back {
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  opacity: 0;
  transition: all .3s;
}

.share-back.active {
  opacity: 1;
  transition: all .3s;
}

.share-container {
  width: 620rpx;
  margin: 0 auto;
  background: #F5F4F6;
  position: fixed;
  min-height: 92vh;
  top: 5%;
  left: 10%;
  /* transform: translate(-50%, -50%); */
  z-index: 999;
  border-radius: 30rpx;
  transform: translateY(100%);
  transition: all .3s;

}

.share-image {
  width: 620rpx;
  /* margin: 120rpx auto 0; */
  height: 90vh;
  display: block;
  border-radius: 16rpx;
  /* box-shadow: 0px 4rpx 8px 0px rgba(0, 0, 0, 0.1); */
}

.share-container.active {
  transform: translateY(0%);
  transition: all .3s;
}

.close {
  width: 30rpx;
  height: 30rpx;
  overflow: hidden;
  position: absolute;
  right: 64rpx;
  top: 64rpx;
}

.close::after {
  transform: rotate(-45deg);
}

.close::before {
  transform: rotate(45deg);
}

.close::before,
.close::after {
  content: '';
  position: absolute;
  height: 3rpx;
  width: 100%;
  top: 50%;
  left: 0;
  margin-top: -2rpx;
  background: #9C9C9C;
}



.share-tips {
  width: 100%;
  text-align: center;
  color: #3C3C3C;
  font-size: 28rpx;
}

.save-btn {
  width: 80%;
  height: 76rpx;
  margin: 24rpx auto;
  background:#2623D1;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 38rpx;
  text-align: center;
  line-height: 76rpx;
}
.can-btn {
  width: 80%;
  height: 76rpx;
  font-size: 28rpx;
  margin: 24rpx auto;
  background:#EAEAFF;
  color: #2623D1;
  border-radius: 38rpx;
  text-align: center;
  line-height: 76rpx;
}
