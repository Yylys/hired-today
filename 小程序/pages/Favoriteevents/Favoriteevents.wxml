<!--pages/Favoriteevents/Favoriteevents.wxml-->
<view>
  <paging reqUrl="/v1/resume/my-activity" params='{{params}}'  immediatecheck="{{false}}" pagingRefField="paging">
    <!--components/card/index.wxml-->
    <view class="boxs">
      <view class="card" wx:for="{{list}}" bind:tap="goinfo" data-path="/pages/plazainfo/plazainfo" data-sid="{{item.sid}}">
        <!-- 上层 -->
        <view style="display: flex; padding: 20rpx;">
          <!-- 左册 -->
          <view>
            <image class="img" src="{{imgurl + item.posters.cover}}" alt="" />
          </view>
          <!-- 右侧 -->
          <view>
            <view style="display: flex;">
              <view class="text2" style="width: 238rpx;height: 80rpx; margin-right: 5rpx; font-weight: 700;">
                <span class="line-clamp-2" style="font-size: 28rpx;"> {{item.title}}</span>
              </view>
              <view wx:if="{{item.activityStatus==1}}" class="text">Upcoming</view>
              <view wx:if="{{item.activityStatus==2}}" class="text">Signing up</view>
              <view wx:if="{{item.activityStatus==3}}" class="text">In progress</view>
              <view wx:if="{{item.activityStatus==4}}" class="text">Closed</view>
            </view>
            <view style="width: 354rpx; font-size: 24rpx;margin-top: 12rpx;" class="text2">{{item.description}}</view>
          </view>
        </view>
        <!-- 下层 -->
        <view style="display: flex; justify-content: space-between; align-items: center; padding: 0 0rpx 0 20rpx">
          <view class="time">Ends on {{item.endTime}}</view>
          <view class='money'>￥{{item.fee/100}}<span style="color:#AAA6B9">/Per</span></view>
        </view>
      </view>
    </view>
  </paging>
</view>