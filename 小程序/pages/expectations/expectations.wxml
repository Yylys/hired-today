      <view class="weui-cell__bd" style="background-color: #fff; margin-top: 20rpx; border-radius: 20rpx;" wx:for="{{expectations.cardList}}">
        <!-- 循环 -->
        <view class="card">
          <view class="title">Preferred City</view>
          <input class="weui-inputs" bindinput="handleInputChange" data-index="{{index}}" value="{{item.desiredCity}}" placeholder="Please Enter" placeholder-class="placeholder" />
        </view>
        <view class="card">
          <view class="title">Desired Position</view>
          <input class="weui-inputs" bindinput="handleInputChange1" data-index="{{index}}" value="{{item.desiredIndustry}}" placeholder="Please Enter" placeholder-class="placeholder" />
        </view>
        <view class="card">
          <view class="title"> Expected Salary
            <view style="color: #9197AF;">(Please enter a whole number in CNY.)</view>
          </view>

          <view style="display: flex; align-items: center; justify-content: space-between; ">
