        <view class="card">
          <view class="title">Desired Job Type</view>
          <input disabled bind:tap="shows" data-index="{{index}}" class="weui-inputs" name="companyName" value="{{item.workTypeName}}" placeholder="Please Enter" placeholder-class="placeholder" />
        </view>
        <view style="width: 520rpx; margin:50rpx auto;">
          <van-button wx:if="{{expectations.cardList.length-1==index}}" bind:tap="onAdd" custom-class="btn" custom-style="border-color: #fff;box-shadow: 0rpx 4rpx 20rpx 0rpx rgba(153,171,198,0.28);" icon="add-o" plain color="#FF9228" block>Add position</van-button>
        </view>
      </view>
      <view style="margin: 78rpx auto; width: 60%; padding-bottom: 100rpx;">
        <van-button formType="submit" type="primary" color="#2623D1" block>Submit</van-button>
      </view>
    </form>
  </view>
  <van-popup show="{{ show }}" bind:close="onClose" position="bottom">
    <van-picker confirm-button-text="confirm" cancel-button-text="cancel" columns="{{ columns }}" default-index="{{ 1 }}" bind:cancel="onClose" bind:confirm="onConfirm" show-toolbar title="Desired Job Type" />
  </van-popup>
